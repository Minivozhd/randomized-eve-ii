if(NOT DEFINED MANIFEST OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "MANIFEST and DESTINATION are required")
endif()
include("${MANIFEST}")
foreach(resource IN LISTS PE2_RUNTIME_FILES)
    get_filename_component(parent "${DESTINATION}/${resource}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${PE2_RESOURCE_SOURCE}/${resource}" "${DESTINATION}/${resource}" ONLY_IF_DIFFERENT)
endforeach()
